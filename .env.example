# Local Stripe TEST mode only.
# Copy to .env.local (gitignored). Never put sk_test on Netlify production.
#
# 1. Stripe Dashboard → Test mode → Developers → API keys → Secret key (sk_test_…)
# 2. $env:STRIPE_SECRET_KEY="sk_test_..."
#    node scripts/stripe-test-catalog.mjs
# 3. Paste the printed STRIPE_PRICE_* lines below.
# 4. Leave DATABASE_URL unset so npm run dev uses PGLite, not live Supabase.
# 5. Card: 4242 4242 4242 4242, any future expiry, any CVC.

STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_SHOP_MONTHLY=
STRIPE_PRICE_SHOP_ANNUAL=
STRIPE_PRICE_SEAT_MONTHLY=
STRIPE_PRICE_MANAGE_MONTHLY=
STRIPE_PRICE_MANAGE_ANNUAL=
STRIPE_PRICE_MANAGE_EXTRA_MONTHLY=
STRIPE_PRICE_MANAGE_EXTRA_ANNUAL=
